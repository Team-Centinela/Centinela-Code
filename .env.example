# Centinela - Local emulator host ports.
#
# Copy this file to .env (gitignored) and adjust if your machine has port
# conflicts (e.g. another Postgres on 5432, RabbitMQ on 5672, local SQL
# Server on 1433, etc.). docker-compose.yml and the verify-emulators
# scripts read this same file.
#
#   cp .env.example .env
#   docker compose up -d --wait
#   ./scripts/verify-emulators.sh        # bash
#   .\scripts\verify-emulators.ps1       # PowerShell
#
# Defaults match PR #171 (Phase 0.0 emulator stack). Behaviour is
# unchanged for anyone who doesn't copy this file to .env.

# Postgres (postgis/postgis:16-3.4-alpine)
POSTGRES_PORT=5432

# Service Bus Emulator (mcr.microsoft.com/azure-messaging/servicebus-emulator)
SERVICEBUS_AMQP_PORT=5672
SERVICEBUS_MGMT_PORT=5300

# SQL Edge (mcr.microsoft.com/azure-sql-edge) - state store for SB Emulator
SQLEDGE_PORT=1433

# Floci-AZ (floci/floci-az) - Blob + KV + AppConfig + Monitor
FLOCI_AZ_PORT=4577

# Spring Boot services (per services/<name>/src/main/resources/application.yml)
INGESTION_PORT=8081
CORE_BACKEND_PORT=8080
SERVERLESS_ENGINE_PORT=8082
