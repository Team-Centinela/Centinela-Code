project               = "centinela"
environment           = "dev"
location              = "eastus2"
subscription_id       = "6c3ca994-9b84-4788-ba81-2a3c84e1bf85"
tenant_id             = "b1ca2d7d-3550-4672-b2e4-83fc05dbfe48"
github_org            = "Team-Centinela"
github_repo           = "Centinela-Code"
oidc_federated_branch = "develop"

# Live tenant default domain (verified 2026-08-02): Torreslopezsebastian6hotmai.onmicrosoft.com.
# Default owner email is the operator tenant contact; promote to centinela-platform@<tenant>
# once the AAD group is provisioned. ADR-002 §WORM + ADR-007 §7.7.
aad_owner_email       = "sanchezsantiago1001@gmail.com"

postgresql_admin_password              = null
postgresql_aad_administrator_login     = "terraform-deployer"
postgresql_aad_administrator_object_id = ""
postgresql_extensions                  = ["postgis", "uuid-ossp", "pg_stat_statements"]

# ACR login server derived from the subscription-derived suffix (6c3ca9). The plan
# resolves every azurerm_container_app.image reference even before any image is
# pushed, per the Spring boot image contract.
ingestion_image         = "acrcentineladev6c3ca9.azurecr.io/centinela-ingestion:0.0.1-SNAPSHOT"
serverless_engine_image = "acrcentineladev6c3ca9.azurecr.io/centinela-serverless-engine:0.0.1-SNAPSHOT"
core_backend_image      = "acrcentineladev6c3ca9.azurecr.io/centinela-core-backend:0.0.1-SNAPSHOT"

ocr_worker_enabled             = false
ocr_worker_image               = "acrcentineladev6c3ca9.azurecr.io/centinela-ocr-worker:0.0.1-SNAPSHOT"
document_intelligence_endpoint = null

budget_alert_emails = ["sanchezsantiago1001@gmail.com"]
teams_webhook_url   = null

worm_owner_group_principal = ""

# ---------------------------------------------------------------------------
# Export the live Azure environment variables before running terraform plan so
# the provider can authenticate without a CLI auth probe failure. From a
# PowerShell session where `az login` has already been issued, run:
#
#   $env:ARM_TENANT_ID          = "b1ca2d7d-3550-4672-b2e4-83fc05dbfe48"
#   $env:ARM_SUBSCRIPTION_ID   = "6c3ca994-9b84-4788-ba81-2a3c84e1bf85"
#   $env:ARM_USE_CLI           = "true"
#
# Then `terraform init -backend=false && terraform plan -var-file=terraform.tfvars.example`.
# ---------------------------------------------------------------------------
